generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EXPERT
  REVIEWER
}

enum TaskStatus {
  UNASSIGNED
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  IN_REVIEW
  REWORK
  APPROVED
}

enum ReviewStatus {
  OPEN
  COMPLETED
}

enum ReviewDecision {
  APPROVED
  REWORK_REQUESTED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
}

enum AuditAction {
  PROJECT_CREATED
  TASK_CREATED
  EXPERT_ASSIGNED
  TASK_STATUS_CHANGED
  TASK_STARTED
  SUBMISSION_CREATED
  SUBMISSION_UPDATED
  SUBMISSION_SUBMITTED
  RUBRIC_CREATED
  RUBRIC_VERSION_CREATED
  REVIEW_CREATED
  REVIEW_SCORE_CREATED
  REVIEW_SCORE_UPDATED
  REVIEW_APPROVED
  REVIEW_REWORK_REQUESTED
}

model User {
  id                  String       @id @default(uuid()) @db.Uuid
  email               String       @unique
  passwordHash        String
  role                Role
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  projects            Project[]    @relation("ProjectCreator")
  assignedAssignments Assignment[] @relation("AssignedExpert")
  madeAssignments     Assignment[] @relation("AssignmentMaker")
  reviews             Review[]
  auditLogs           AuditLog[]   @relation("AuditActor")
}

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation("ProjectCreator", fields: [createdById], references: [id])
  tasks       Task[]
  rubrics     Rubric[]
}

model Task {
  id           String       @id @default(uuid()) @db.Uuid
  projectId    String       @db.Uuid
  title        String
  instructions String
  status       TaskStatus   @default(UNASSIGNED)
  version      Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignments  Assignment[]

  @@index([projectId, status])
}

model Assignment {
  id           String   @id @default(uuid()) @db.Uuid
  taskId       String   @unique @db.Uuid
  expertId     String   @db.Uuid
  assignedById String   @db.Uuid
  assignedAt   DateTime @default(now())
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  expert       User     @relation("AssignedExpert", fields: [expertId], references: [id])
  assignedBy   User     @relation("AssignmentMaker", fields: [assignedById], references: [id])
  submissions  Submission[]

  @@index([expertId, taskId])
}

model Submission {
  id           String           @id @default(uuid()) @db.Uuid
  assignmentId String           @db.Uuid
  version      Int
  status       SubmissionStatus @default(DRAFT)
  content      String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  submittedAt  DateTime?
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  reviews      Review[]

  @@unique([assignmentId, version])
  @@index([assignmentId, createdAt])
  @@index([assignmentId, status])
}

model Rubric {
  id        String          @id @default(uuid()) @db.Uuid
  projectId String          @db.Uuid
  name      String
  createdAt DateTime        @default(now())
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions  RubricVersion[]
}

model RubricVersion {
  id        String            @id @default(uuid()) @db.Uuid
  rubricId  String            @db.Uuid
  version   Int
  createdAt DateTime          @default(now())
  rubric    Rubric            @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  criteria  RubricCriterion[]
  reviews   Review[]

  @@unique([rubricId, version])
}

model RubricCriterion {
  id              String        @id @default(uuid()) @db.Uuid
  rubricVersionId String        @db.Uuid
  name            String
  description     String?
  minScore        Decimal       @db.Decimal(6, 2)
  maxScore        Decimal       @db.Decimal(6, 2)
  weight          Decimal       @db.Decimal(6, 2)
  position        Int
  rubricVersion   RubricVersion @relation(fields: [rubricVersionId], references: [id], onDelete: Cascade)
  scores          ReviewScore[]

  @@unique([rubricVersionId, position])
}

model Review {
  id              String        @id @default(uuid()) @db.Uuid
  submissionId    String        @db.Uuid
  reviewerId      String        @db.Uuid
  rubricVersionId String        @db.Uuid
  status          ReviewStatus  @default(OPEN)
  decision        ReviewDecision?
  createdAt       DateTime      @default(now())
  completedAt     DateTime?
  submission      Submission    @relation(fields: [submissionId], references: [id])
  reviewer        User          @relation(fields: [reviewerId], references: [id])
  rubricVersion   RubricVersion @relation(fields: [rubricVersionId], references: [id])
  scores          ReviewScore[]

  @@unique([submissionId, reviewerId])
  @@index([reviewerId, status])
}

model ReviewScore {
  id                String          @id @default(uuid()) @db.Uuid
  reviewId          String          @db.Uuid
  rubricCriterionId String          @db.Uuid
  score             Decimal         @db.Decimal(6, 2)
  comment           String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  review            Review          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  rubricCriterion   RubricCriterion @relation(fields: [rubricCriterionId], references: [id])

  @@unique([reviewId, rubricCriterionId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @db.Uuid
  entityType String
  entityId   String   @db.Uuid
  action     AuditAction
  before     Json?
  after      Json?
  requestId  String?
  createdAt  DateTime @default(now())
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}
